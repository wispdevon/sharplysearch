#!/usr/bin/env bash
# Search live cameras and lenses through Sharply's supported developer API.
set -euo pipefail

readonly script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly root="$(cd -- "$(dirname -- "$script_path")" && pwd)"
readonly style="$root/wofi-style.css"
readonly detail_style="$root/wofi-details.css"
readonly site='https://www.sharplyphoto.com'
readonly api="$site/api/v1"
readonly config_file="${XDG_CONFIG_HOME:-$HOME/.config}/sharply-search/.env"
readonly cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sharply-search"
readonly catalog_cache="$cache_dir/catalog-v1.json"
readonly catalog_etag="$cache_dir/catalog-v1.etag"
readonly catalog_checked="$cache_dir/catalog-v1.checked"
readonly catalog_rows="$cache_dir/catalog.rows"
readonly catalog_lookup="$cache_dir/catalog.lookup.tsv"
readonly catalog_manifest="$cache_dir/catalog.manifest"
readonly spec_registry_cache="$cache_dir/spec-registry-v1.json"
readonly cache_format_version=5
readonly catalog_refresh_seconds=3600
readonly spec_fields='gear.basics,camera.sensor,camera.shutter,camera.fixed-lens,camera.build,camera.focus,camera.power,camera.video,camera.features,lens.optics,lens.aperture,lens.focus,lens.stabilization,lens.build,lens.filters,lens.accessories,lens.tiltShift,analog.camera'
readonly timing_log="${SHARPLY_SEARCH_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/sharply-search/timing.log}"
timing_started=${EPOCHREALTIME/./}
timing_previous=$timing_started

log_timing() {
  local event=$1 now elapsed delta
  now=${EPOCHREALTIME/./}
  elapsed=$(((10#$now - 10#$timing_started) / 1000))
  delta=$(((10#$now - 10#$timing_previous) / 1000))
  printf '%(%Y-%m-%dT%H:%M:%S%z)T  +%6d ms  total=%6d ms  %s\n' \
    -1 "$delta" "$elapsed" "$event" >>"$timing_log" 2>/dev/null || true
  timing_previous=$now
}

mkdir -p -- "${timing_log%/*}" 2>/dev/null || true
log_timing 'launcher started'

show_message() {
  if ! command -v wofi >/dev/null; then
    printf 'sharply-search: %s\n' "$1" >&2
    return
  fi
  printf '%s\n' "$1" | wofi --dmenu --prompt 'Sharply gear' --style "$style" \
    --location center --width "$(search_window_width)" --lines 1 --no-custom-entry >/dev/null || true
}

api_get() {
  local output=$1 endpoint=$2 status message
  shift 2

  # Feed sensitive headers through curl's stdin config so the key is not visible
  # in the process command line.
  if ! status=$(printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' \
    "$SHARPLY_API_KEY" | curl --config - --silent --show-error --max-time 20 \
    --output "$output" --write-out '%{http_code}' "$@" "$api/$endpoint"); then
    show_message 'Could not connect to the Sharply API.'
    return 1
  fi

  if [[ $status != 2* ]]; then
    message=$(jq -r '.error.message // empty' "$output" 2>/dev/null || true)
    [[ -n $message ]] || message="Sharply API request failed (HTTP $status)."
    show_message "$message"
    return 1
  fi

  if ! jq -e . "$output" >/dev/null 2>&1; then
    show_message 'Sharply returned an invalid API response.'
    return 1
  fi
}

api_try_get() {
  local output=$1 endpoint=$2 status
  shift 2

  status=$(printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' \
    "$SHARPLY_API_KEY" | curl --config - --silent --show-error --max-time 20 \
    --output "$output" --write-out '%{http_code}' "$@" "$api/$endpoint") || return 1
  [[ $status == 2* ]] && jq -e . "$output" >/dev/null 2>&1
}

cache_gear_image() {
  local source_url=$1 output=$2 url_file=$3 image_dir image_tmp
  local url_tmp content_type
  image_dir=${output%/*}
  image_tmp=$(mktemp "$image_dir/.gear-image-source.XXXXXX")
  url_tmp=$(mktemp "$image_dir/.gear-image-url.XXXXXX")

  content_type=$(curl --silent --show-error --fail --location \
    --proto '=https' --proto-redir '=https' --max-time 15 \
    --output "$image_tmp" --write-out '%{content_type}' "$source_url" || true)
  if [[ $content_type != image/* || ! -s $image_tmp ]]; then
    rm -f -- "$image_tmp" "$url_tmp"
    return 1
  fi

  printf '%s\n' "$source_url" >"$url_tmp"
  mv -f -- "$image_tmp" "$output"
  mv -f -- "$url_tmp" "$url_file"
}

hero_image_size() {
  local image=$1 layout=$2 width=0 height=0

  if command -v identify >/dev/null; then
    read -r width height _ < <(
      identify -ping -format '%w %h\n' -- "$image" 2>/dev/null | head -n 1
    ) || true
  fi

  if [[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] && ((height > 0)); then
    if [[ $layout == double ]] && ((width * 210 > height * 330)); then
      printf '330px auto\n'
    elif [[ $layout == single ]] && ((width * 210 > height * 680)); then
      printf '680px auto\n'
    else
      printf 'auto 210px\n'
    fi
  else
    printf 'auto 210px\n'
  fi
}

catalog_cache_valid() {
  [[ -s $catalog_cache ]] || return 1
  jq -e '
    ((.version | type) == "string" and (.version | startswith("sha256-")))
    and ((.generatedAt | type) == "string")
    and ((.itemCount | type) == "number" and .itemCount > 0)
    and ((.data | type) == "array")
    and ((.data | length) == .itemCount)
    and all(.data[];
      (.name | type == "string" and length > 0)
      and (.slug | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
      and (.brandName | type == "string" and length > 0)
      and (.gearType | type == "string" and test("CAMERA|LENS")))
  ' "$catalog_cache" >/dev/null 2>&1
}

catalog_needs_refresh() {
  local checked_at=0
  catalog_cache_valid || return 0
  [[ -r $catalog_checked ]] && checked_at=$(stat -c '%Y' "$catalog_checked" 2>/dev/null || printf '0')
  ((EPOCHSECONDS - checked_at >= catalog_refresh_seconds))
}

refresh_catalog() {
  local body_tmp headers_tmp etag_tmp status message cached_etag=''
  mkdir -p -- "$cache_dir"
  body_tmp=$(mktemp "$cache_dir/.catalog-response.XXXXXX")
  headers_tmp=$(mktemp "$cache_dir/.catalog-headers.XXXXXX")
  etag_tmp=$(mktemp "$cache_dir/.catalog-etag.XXXXXX")
  [[ -r $catalog_etag ]] && IFS= read -r cached_etag <"$catalog_etag"

  if ! status=$(
    {
      printf 'header = "Authorization: Bearer %s"\nheader = "Accept: application/json"\n' "$SHARPLY_API_KEY"
      [[ -z $cached_etag ]] || printf 'header = "If-None-Match: %s"\n' "$cached_etag"
    } | curl --config - --silent --show-error --max-time 20 --dump-header "$headers_tmp" \
      --output "$body_tmp" --write-out '%{http_code}' "$api/catalog"
  ); then
    rm -f -- "$body_tmp" "$headers_tmp" "$etag_tmp"
    return 1
  fi

  if [[ $status == 304 ]] && catalog_cache_valid; then
    : >"$catalog_checked"
    rm -f -- "$body_tmp" "$headers_tmp" "$etag_tmp"
    log_timing 'catalog unchanged (HTTP 304)'
    return 0
  fi

  if [[ $status != 2* ]]; then
    message=$(jq -r '.error.message // empty' "$body_tmp" 2>/dev/null || true)
    [[ -n $message ]] || message="Sharply catalog request failed (HTTP $status)."
    rm -f -- "$body_tmp" "$headers_tmp" "$etag_tmp"
    printf 'sharply-search: %s\n' "$message" >&2
    return 1
  fi

  if ! jq -e '
    ((.version | type) == "string" and (.version | startswith("sha256-")))
    and ((.generatedAt | type) == "string")
    and ((.itemCount | type) == "number" and .itemCount > 0)
    and ((.data | type) == "array")
    and ((.data | length) == .itemCount)
    and all(.data[];
      (.name | type == "string" and length > 0)
      and (.slug | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
      and (.brandName | type == "string" and length > 0)
      and (.gearType | type == "string" and test("CAMERA|LENS")))
  ' "$body_tmp" >/dev/null 2>&1; then
    rm -f -- "$body_tmp" "$headers_tmp" "$etag_tmp"
    printf 'sharply-search: Sharply returned an invalid catalog response.\n' >&2
    return 1
  fi

  awk 'BEGIN { IGNORECASE=1 } /^etag:/ {
    sub(/^[^:]+:[[:space:]]*/, ""); sub(/\r$/, ""); print; exit
  }' "$headers_tmp" >"$etag_tmp"
  if [[ ! -s $etag_tmp ]]; then
    jq -r '.version | "\"" + . + "\""' "$body_tmp" >"$etag_tmp"
  fi
  mv -f -- "$body_tmp" "$catalog_cache"
  mv -f -- "$etag_tmp" "$catalog_etag"
  : >"$catalog_checked"
  rm -f -- "$headers_tmp"
  log_timing "catalog downloaded ($(jq -r '.itemCount' "$catalog_cache") items)"
}

catalog_index_is_current() {
  local format_version catalog_version cached_catalog_version
  [[ -s $catalog_rows && -s $catalog_lookup && -r $catalog_manifest ]] || return 1
  { IFS= read -r format_version; IFS= read -r cached_catalog_version; } <"$catalog_manifest" || return 1
  catalog_version=$(jq -r '.version // empty' "$catalog_cache")
  [[ $format_version == "$cache_format_version" && $cached_catalog_version == "$catalog_version" ]]
}

search_window_width() {
  local line physical_width=0 physical_height=0 scale='1' transform=0
  local dimension logical_width width scale_whole scale_fraction scale_number

  if command -v hyprctl >/dev/null; then
    while IFS= read -r line; do
      if [[ $line =~ ^[[:space:]]+([0-9]+)x([0-9]+)@ ]]; then
        physical_width=${BASH_REMATCH[1]}
        physical_height=${BASH_REMATCH[2]}
      elif [[ $line =~ ^[[:space:]]+scale:[[:space:]]+([0-9.]+) ]]; then
        scale=${BASH_REMATCH[1]}
      elif [[ $line =~ ^[[:space:]]+transform:[[:space:]]+([0-9]+) ]]; then
        transform=${BASH_REMATCH[1]}
      elif [[ $line =~ ^[[:space:]]+focused:[[:space:]]+yes$ ]]; then
        break
      elif [[ $line == Monitor\ * ]]; then
        physical_width=0
        physical_height=0
        scale='1'
        transform=0
      fi
    done < <(hyprctl monitors 2>/dev/null)
  fi

  if ((physical_width == 0 || physical_height == 0)); then
    printf '800\n'
    return
  fi

  if ((transform % 2 == 1)); then
    dimension=$physical_height
  else
    dimension=$physical_width
  fi

  if [[ $scale == *.* ]]; then
    scale_whole=${scale%%.*}
    scale_fraction=${scale#*.}
    scale_fraction=${scale_fraction:0:2}
    while ((${#scale_fraction} < 2)); do scale_fraction+=0; done
    scale_number=$((10#$scale_whole * 100 + 10#$scale_fraction))
    logical_width=$((dimension * 100 / scale_number))
  else
    logical_width=$((dimension / scale))
  fi

  width=$((logical_width * 92 / 100))
  ((width > 800)) && width=800
  printf '%d\n' "$width"
}

build_catalog_cache() {
  local master_tmp rows_tmp lookup_tmp manifest_tmp
  local choice_markup name brand slug thumbnail_url gear_type count=0 catalog_version

  command -v jq >/dev/null || {
    printf 'sharply-search: jq is required to build the catalog cache\n' >&2
    return 1
  }
  catalog_cache_valid || {
    printf 'sharply-search: the API catalog cache is missing or invalid\n' >&2
    return 1
  }

  mkdir -p -- "$cache_dir"
  master_tmp=$(mktemp "$cache_dir/.catalog-master.XXXXXX")
  rows_tmp=$(mktemp "$cache_dir/.catalog-rows.XXXXXX")
  lookup_tmp=$(mktemp "$cache_dir/.catalog-lookup.XXXXXX")
  manifest_tmp=$(mktemp "$cache_dir/.catalog-manifest.XXXXXX")

  if ! jq -er '
    if (.data | type) != "array" then error("catalog data must be an array") else . end
    |
    def span($color; $weight; $text; $size):
      "<span foreground=\"" + $color + "\" weight=\"" + $weight
      + "\"" + (if $size == "" then "" else " size=\"" + $size + "\"" end)
      + ">" + ($text | @html) + "</span>";
    def pad($width):
      . + (" " * ([($width - length), 0] | max));
    def brand_markup($brand; $width):
      ($brand | ascii_downcase) as $key
      | ($brand | pad($width)) as $padded
      | if $key == "panasonic" then span("#4f8cff"; "700"; $padded; "smaller")
        elif $key == "canon" then span("#f04b4b"; "700"; $padded; "smaller")
        elif $key == "fuji" or $key == "fujifilm" then span("#49a66f"; "700"; $padded; "smaller")
        elif $key == "nikon" then span("#f4cf42"; "700"; $padded; "smaller")
        elif $key == "phase one" or $key == "phaseone" or $key == "sirui" then
          span("#76c7e8"; "700"; $padded; "smaller")
        elif $key == "astrhori" or $key == "7artisans" then
          span("#f04b4b"; "750"; $padded[0:1]; "smaller")
          + span("#f2f0ea"; "700"; $padded[1:]; "smaller")
        elif $key == "ttartisan" or $key == "ttartisans" then
          span("#f04b4b"; "750"; $padded[0:2]; "smaller")
          + span("#f2f0ea"; "700"; $padded[2:]; "smaller")
        else span("#a6abb0"; "650"; $padded; "smaller")
        end;
    def product_name($name; $brand):
      if (($name | ascii_downcase) | startswith($brand | ascii_downcase))
         and ($name[($brand | length):($brand | length) + 1] | test("\\s"))
      then ($name[($brand | length):] | sub("^\\s+"; ""))
      else $name
      end;
    def mount_aliases($name; $brand):
      if $brand == "Canon" and ($name | test("\\bRF-S\\b"; "i")) then "canon rf-s mount"
      elif $brand == "Canon" and ($name | test("\\bRF\\b"; "i")) then "canon rf mount"
      elif $brand == "Canon" and ($name | test("\\bEF-S\\b"; "i")) then "canon ef-s mount"
      elif $brand == "Canon" and ($name | test("\\bEF-M\\b"; "i")) then "canon ef-m mount"
      elif $brand == "Canon" and ($name | test("\\bEF\\b"; "i")) then "canon ef mount"
      elif $brand == "Nikon" and ($name | test("\\bNIKKOR Z\\b"; "i")) then "nikon z mount"
      elif $brand == "Nikon" and ($name | test("\\b(AF-S|AF-P|AI-S|DX)\\b"; "i")) then "nikon f mount"
      elif $brand == "Sony" and ($name | test("\\b(FE|E)\\b"; "i")) then "sony e mount"
      elif $brand == "Fujifilm" and ($name | test("\\b(GF)\\b"; "i")) then "fujifilm g mount"
      elif $brand == "Fujifilm" and ($name | test("\\b(XF|XC)\\b"; "i")) then "fujifilm x mount"
      elif ($brand == "Olympus" or $brand == "OM System")
        and ($name | test("\\bM[.]?ZUIKO\\b"; "i"))
        then "micro four thirds mft m43 mount"
      elif $brand == "Panasonic" and ($name | test("\\bLUMIX S\\b"; "i")) then "leica l mount"
      elif $brand == "Panasonic" and ($name | test("\\bLUMIX G\\b"; "i"))
        then "micro four thirds mft m43 mount"
      else ""
      end;
    def search_aliases($item):
      $item.name as $name
      | $item.gearType as $gear_type
      | ($item.brandName // "Unknown") as $brand
      | [
          ($item.releaseDate // "" | .[0:4]),
          ($item.announcedDate // "" | .[0:4]),
          mount_aliases($name; $brand)
        ] as $metadata
      | if $gear_type != "LENS" then ($metadata | map(select(length > 0)) | join(" "))
      else
        ([$name | scan("([0-9]+(?:\\.[0-9]+)?)\\s*mm"; "i") | .[0] | tonumber]
          | max // 0) as $longest_focal_length
        | ($name | test("[0-9]+(?:\\.[0-9]+)?\\s*[-–—]\\s*[0-9]+(?:\\.[0-9]+)?\\s*mm"; "i")) as $is_zoom
        | ($metadata + [
            (if $is_zoom then "zoom zoom lens" else
              if $longest_focal_length > 0 then "prime prime lens fixed focal length" else empty end
            end),
            (if ($name | test("(^|[^0-9])50(?:\\.0)?\\s*mm"; "i"))
                  and ($name | test("[-–—]\\s*50(?:\\.0)?\\s*mm"; "i") | not)
              then "nifty fifty" else empty end),
            (if $name | test("(^|[^0-9])(35|40|45|50|55|58|60)(?:\\.0)?\\s*mm"; "i")
              then "human eye normal" else empty end),
            (if $longest_focal_length >= 70 then "tight tele telephoto" else empty end),
            (if $name | test("\\bpancake\\b"; "i")
              then "pancake compact slim low profile short lens height" else empty end)
          ])
        | map(select(length > 0))
        | join(" ")
      end;
    def hidden_search_text($text):
      if $text == "" then ""
      else "<span alpha=\"1\" size=\"1\"> " + ($text | @html) + "</span>"
      end;

    ([.data[].brandName // "Unknown" | length] | max // 7) as $brand_width
    | .data[]
    | .name as $name
    | (.brandName // "Unknown") as $brand
    | .gearType as $gear_type
    | product_name($name; $brand) as $product
    | (brand_markup($brand; $brand_width)
       + "  " + span("#f2f0ea"; "650"; $product; "")
       + "  " + span("#7e8995"; "500"; "· " + ($gear_type | ascii_downcase); "smaller")
       + hidden_search_text(search_aliases(.))) as $markup
    | [$markup, $name, $brand, .slug, (.thumbnailUrl // "-"), .gearType]
    | join("\t")
  ' "$catalog_cache" >"$master_tmp"; then
    rm -f -- "$master_tmp" "$rows_tmp" "$lookup_tmp" "$manifest_tmp"
    printf 'sharply-search: the cached API catalog is invalid\n' >&2
    return 1
  fi

  while IFS=$'\t' read -r choice_markup name brand slug thumbnail_url gear_type; do
    [[ -n $choice_markup && -n $name && -n $slug ]] || continue
    printf '%s\n' "$choice_markup" >>"$rows_tmp"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$choice_markup" "$name" "$brand" "$slug" "$thumbnail_url" "$gear_type" >>"$lookup_tmp"
    ((count += 1))
  done <"$master_tmp"
  rm -f -- "$master_tmp"

  if ((count == 0)); then
    rm -f -- "$rows_tmp" "$lookup_tmp" "$manifest_tmp"
    printf 'sharply-search: the local catalog is empty\n' >&2
    return 1
  fi

  catalog_version=$(jq -r '.version' "$catalog_cache")
  printf '%s\n%s\n' "$cache_format_version" "$catalog_version" >"$manifest_tmp"
  mv -f -- "$rows_tmp" "$catalog_rows"
  mv -f -- "$lookup_tmp" "$catalog_lookup"
  mv -f -- "$manifest_tmp" "$catalog_manifest"
  log_timing "catalog cache rebuilt ($count items)"
}

rebuild_requested=false
case ${1:-} in
  '') ;;
  --rebuild-cache)
    (($# == 1)) || {
      printf 'Usage: sharply-search [--rebuild-cache]\n' >&2
      exit 2
    }
    rebuild_requested=true
    ;;
  *)
    printf 'Usage: sharply-search [--rebuild-cache]\n' >&2
    exit 2
    ;;
esac

for dependency in curl jq; do
  command -v "$dependency" >/dev/null || {
    show_message "$dependency is not installed."
    exit 1
  }
done
if [[ $rebuild_requested == false ]] && ! command -v wofi >/dev/null; then
  printf 'sharply-search: wofi is not installed\n' >&2
  exit 1
fi

# Read dotenv values without executing the file as shell code.
if [[ -z ${SHARPLY_API_KEY:-} && -r $config_file ]]; then
  SHARPLY_API_KEY=$(sed -n \
    's/^[[:space:]]*SHARPLY_API_KEY[[:space:]]*=[[:space:]]*//p' \
    "$config_file" | tail -n 1)
  SHARPLY_API_KEY=${SHARPLY_API_KEY%$'\r'}
  if [[ $SHARPLY_API_KEY == \"*\" || $SHARPLY_API_KEY == \'*\' ]]; then
    SHARPLY_API_KEY=${SHARPLY_API_KEY:1:${#SHARPLY_API_KEY}-2}
  fi
fi
if [[ -z ${SHARPLY_WAIT_FOR_IMAGE:-} && -r $config_file ]]; then
  SHARPLY_WAIT_FOR_IMAGE=$(sed -n \
    's/^[[:space:]]*SHARPLY_WAIT_FOR_IMAGE[[:space:]]*=[[:space:]]*//p' \
    "$config_file" | tail -n 1)
  SHARPLY_WAIT_FOR_IMAGE=${SHARPLY_WAIT_FOR_IMAGE%$'\r'}
  if [[ $SHARPLY_WAIT_FOR_IMAGE == \"*\" || $SHARPLY_WAIT_FOR_IMAGE == \'*\' ]]; then
    SHARPLY_WAIT_FOR_IMAGE=${SHARPLY_WAIT_FOR_IMAGE:1:${#SHARPLY_WAIT_FOR_IMAGE}-2}
  fi
fi
SHARPLY_WAIT_FOR_IMAGE=${SHARPLY_WAIT_FOR_IMAGE:-false}
case ${SHARPLY_WAIT_FOR_IMAGE,,} in
  1|true|yes|on) wait_for_image=true ;;
  *) wait_for_image=false ;;
esac

if [[ -z ${SHARPLY_API_KEY:-} ]]; then
  show_message "Add SHARPLY_API_KEY to $config_file"
  exit 1
fi
if [[ $SHARPLY_API_KEY != sharply_live_* ]]; then
  show_message 'The configured Sharply API key has an invalid prefix.'
  exit 1
fi
log_timing 'API configuration initialized'

if [[ $rebuild_requested == true ]] || catalog_needs_refresh; then
  log_timing 'catalog refresh started'
  if ! refresh_catalog; then
    if catalog_cache_valid; then
      : >"$catalog_checked"
      log_timing 'catalog refresh failed; using cached snapshot'
    else
      show_message 'Could not download the Sharply catalog.'
      exit 1
    fi
  fi
else
  log_timing 'catalog snapshot cache hit'
fi

if [[ $rebuild_requested == true ]] || ! catalog_index_is_current; then
  build_catalog_cache || {
    show_message 'Could not build the local Sharply catalog index.'
    exit 1
  }
else
  log_timing 'catalog index cache hit'
fi

if [[ $rebuild_requested == true ]]; then
  printf 'Refreshed Sharply catalog cache in %s\n' "$cache_dir"
  exit 0
fi

search_width=$(search_window_width)
log_timing "opening search window (${search_width}px wide)"
choice=$(wofi --dmenu \
  --prompt 'Search Sharply gear' --insensitive --matching multi-contains \
  --style "$style" --location center --width "$search_width" --height '65%' \
  --define dynamic_lines=true --allow-markup --parse-search \
  --no-custom-entry <"$catalog_rows") || exit 0

selected_name=''
selected_brand=''
slug=''
thumbnail_url=''
selected_gear_type=''
while IFS=$'\t' read -r choice_markup name brand item_slug item_thumbnail item_gear_type; do
  if [[ $choice_markup == "$choice" ]]; then
    selected_name=$name
    selected_brand=$brand
    slug=$item_slug
    thumbnail_url=$item_thumbnail
    selected_gear_type=$item_gear_type
    break
  fi
done <"$catalog_lookup"
[[ -n $selected_name && -n $slug ]] || exit 0
[[ $thumbnail_url != '-' ]] || thumbnail_url=''

for dependency in xdg-open wl-copy; do
  command -v "$dependency" >/dev/null || {
    show_message "$dependency is not installed."
    exit 1
  }
done
log_timing 'post-selection dependencies checked'
detail_response=$(mktemp)
gear_response=$(mktemp)
catalog_response=$(mktemp)
runtime_detail_style=''
runtime_title_svg=''
image_pid=''
secondary_image_pid=''
detail_pid=''
gear_pid=''
registry_pid=''
trap 'for pid in "${image_pid:-}" "${secondary_image_pid:-}" "${detail_pid:-}" "${gear_pid:-}" "${registry_pid:-}"; do [[ -z $pid ]] || kill "$pid" 2>/dev/null || true; done; rm -f "$detail_response" "$gear_response" "$catalog_response" "${runtime_detail_style:-}" "${runtime_title_svg:-}"' EXIT

image_dir="$cache_dir/images"

# The field-label registry changes far less often than individual gear data.
# Fetch it once, in parallel with gear details, then reuse the local cache.
registry_source=$spec_registry_cache
if [[ ! -s $spec_registry_cache ]]; then
  api_get "$catalog_response" specs &
  registry_pid=$!
  registry_source=$catalog_response
  log_timing 'specification registry request started'
else
  log_timing 'specification registry cache hit'
fi

gear_image=''
secondary_gear_image=''
if [[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  image_file="$image_dir/$slug"
  image_url_file="$image_file.url"
  secondary_image_file="$image_dir/$slug-secondary"
  secondary_image_url_file="$secondary_image_file.url"
  cached_image_url=''
  [[ -r $image_url_file ]] && IFS= read -r cached_image_url <"$image_url_file"

  if [[ -z $image_pid && -n $thumbnail_url && \
    (! -s $image_file || $cached_image_url != "$thumbnail_url") ]]; then
    mkdir -p -- "$image_dir"
    {
      if cache_gear_image "$thumbnail_url" "$image_file" "$image_url_file"; then
        log_timing 'thumbnail download completed'
      else
        log_timing 'thumbnail download failed'
        exit 1
      fi
    } &
    image_pid=$!
    log_timing 'thumbnail download started'
  fi
fi

api_get "$detail_response" "gear/$slug/specs" --get \
  --data-urlencode "fields=$spec_fields" &
detail_pid=$!
api_try_get "$gear_response" "gear/$slug" &
gear_pid=$!
log_timing 'gear specification and media requests started'

secondary_thumbnail_url=''
if wait "$gear_pid"; then
  gear_pid=''
  secondary_thumbnail_url=$(jq -r --arg primary "$thumbnail_url" '
    [
      .data.thumbnailUrl?,
      .data.topViewUrl?,
      .data.rearViewUrl?,
      .data.ogImageUrl?
    ]
    | map(select(type == "string" and length > 0 and . != $primary))
    | first // empty
  ' "$gear_response")
  log_timing 'gear media response received'

  if [[ -n $secondary_thumbnail_url ]]; then
    cached_secondary_url=''
    [[ -r $secondary_image_url_file ]] &&
      IFS= read -r cached_secondary_url <"$secondary_image_url_file"
    if [[ ! -s $secondary_image_file ||
      $cached_secondary_url != "$secondary_thumbnail_url" ]]; then
      mkdir -p -- "$image_dir"
      {
        if cache_gear_image "$secondary_thumbnail_url" \
          "$secondary_image_file" "$secondary_image_url_file"; then
          log_timing 'secondary image download completed'
        else
          log_timing 'secondary image download failed'
          exit 1
        fi
      } &
      secondary_image_pid=$!
      log_timing 'secondary image download started'
    fi
  fi
else
  gear_pid=''
  log_timing 'gear media request unavailable'
fi

if ! wait "$detail_pid"; then
  detail_pid=''
  exit 1
fi
detail_pid=''
log_timing "gear specification response received ($slug)"

if [[ -n $registry_pid ]]; then
  if ! wait "$registry_pid"; then
    registry_pid=''
    exit 1
  fi
  registry_pid=''
  mkdir -p -- "$cache_dir"
  registry_tmp=$(mktemp "$cache_dir/.spec-registry.XXXXXX")
  while IFS= read -r registry_line || [[ -n $registry_line ]]; do
    printf '%s\n' "$registry_line"
  done <"$catalog_response" >"$registry_tmp"
  mv -f -- "$registry_tmp" "$spec_registry_cache"
  registry_source=$spec_registry_cache
  log_timing 'specification registry cached'
fi

declare -a detail_lines=()
declare -A detail_copy=()
readonly detail_label_width=34
readonly detail_value_width=68

while IFS=$'\t' read -r label value; do
  [[ -n $label && -n $value ]] || continue

  # Keep each specification within the viewport: long values become exactly
  # two visual rows, while the unabridged value remains available for copying.
  if ((${#label} > detail_label_width)); then
    label_display="${label:0:detail_label_width-1}…"
  else
    printf -v label_display '%-*s' "$detail_label_width" "$label"
  fi

  first_value=${value:0:detail_value_width}
  display_line="$label_display │ $first_value"
  if ((${#value} > detail_value_width)); then
    second_value=${value:detail_value_width:detail_value_width}
    if ((${#value} > detail_value_width * 2)); then
      second_value="${second_value:0:detail_value_width-1}…"
    fi
    printf -v continuation '%*s │ %s' "$detail_label_width" '' "$second_value"
    display_line="$(jq -Rr @html <<<"$display_line")&#10;$(jq -Rr @html <<<"$continuation")"
  else
    display_line=$(jq -Rr @html <<<"$display_line")
  fi

  detail_lines+=("$display_line")
  detail_copy["$display_line"]="$label: $value"
done < <(
  jq -r --slurp '
    (.[0].data.categories
      | map(.fields[])
      | map({ key: .id, value: .label })
      | from_entries) as $labels
    | .[1].data[]
    | [($labels[.id] // .id), .display]
    | @tsv
  ' "$registry_source" "$detail_response"
)
if ((${#detail_lines[@]} == 0)); then
  show_message 'Sharply has no published specifications for this item.'
  exit 0
fi

# Waiting is opt-in. Otherwise an uncached image never delays the detail window
# and remains available from the cache on the next invocation.
if [[ $wait_for_image == true && -n $image_pid ]]; then
  log_timing 'waiting for thumbnail worker'
  wait "$image_pid" 2>/dev/null || true
  image_pid=''
  log_timing 'thumbnail worker wait completed'
fi
if [[ $wait_for_image == true && -n $secondary_image_pid ]]; then
  log_timing 'waiting for secondary image worker'
  wait "$secondary_image_pid" 2>/dev/null || true
  secondary_image_pid=''
  log_timing 'secondary image worker wait completed'
fi

if [[ -n ${image_file:-} && -s ${image_file:-} && -r ${image_url_file:-} ]]; then
  cached_image_url=''
  IFS= read -r cached_image_url <"$image_url_file" || true
fi
if [[ -n ${image_file:-} && -s ${image_file:-} && \
  (-z $thumbnail_url || $cached_image_url == "$thumbnail_url") ]]; then
  gear_image=$image_file
  rm -f -- "$image_dir/$slug-480x240.webp" "$image_dir/$slug-480x240.webp.url"
fi
if [[ -n ${secondary_image_file:-} && -s ${secondary_image_file:-} &&
  -r ${secondary_image_url_file:-} ]]; then
  cached_secondary_url=''
  IFS= read -r cached_secondary_url <"$secondary_image_url_file" || true
  if [[ -n $secondary_thumbnail_url &&
    $cached_secondary_url == "$secondary_thumbnail_url" ]]; then
    secondary_gear_image=$secondary_image_file
  fi
fi

runtime_title_svg=$(mktemp "$cache_dir/.detail-title.XXXXXX.svg")
title_xml=$(jq -Rnr --arg value "$selected_name" '$value | @html')
printf '<svg xmlns="http://www.w3.org/2000/svg" width="748" height="58" viewBox="0 0 748 58"><text x="0" y="44" fill="#f2f0ea" style="font-family:&quot;Space Grotesk&quot;,&quot;Noto Sans&quot;,sans-serif;font-size:40px;font-weight:700;line-height:0.98;letter-spacing:-0.35px">%s</text></svg>\n' \
  "$title_xml" >"$runtime_title_svg"

runtime_detail_style=$(mktemp "$cache_dir/.detail-style.XXXXXX.css")
while IFS= read -r css_line || [[ -n $css_line ]]; do
  printf '%s\n' "$css_line"
done <"$detail_style" >"$runtime_detail_style"
css_title=${runtime_title_svg//\\/\\\\}
css_title=${css_title//\"/\\\"}

if [[ -n $gear_image && -n $secondary_gear_image ]]; then
  css_image=${gear_image//\\/\\\\}
  css_image=${css_image//\"/\\\"}
  css_secondary_image=${secondary_gear_image//\\/\\\\}
  css_secondary_image=${css_secondary_image//\"/\\\"}
  primary_image_size=$(hero_image_size "$gear_image" double)
  secondary_image_size=$(hero_image_size "$secondary_gear_image" double)
  printf '\nwindow {\n  background-image: url("%s"), url("%s"), url("%s");\n  background-repeat: no-repeat, no-repeat, no-repeat;\n  background-position: 26px 20px, 28%% 88px, 72%% 88px;\n  background-size: 748px 58px, %s, %s;\n}\n\n#outer-box {\n  padding-top: 316px;\n}\n' \
    "$css_title" "$css_image" "$css_secondary_image" \
    "$primary_image_size" "$secondary_image_size" >>"$runtime_detail_style"
elif [[ -n $gear_image ]]; then
  css_image=${gear_image//\\/\\\\}
  css_image=${css_image//\"/\\\"}
  primary_image_size=$(hero_image_size "$gear_image" single)
  printf '\nwindow {\n  background-image: url("%s"), url("%s");\n  background-repeat: no-repeat, no-repeat;\n  background-position: 26px 20px, center 88px;\n  background-size: 748px 58px, %s;\n}\n\n#outer-box {\n  padding-top: 316px;\n}\n' \
    "$css_title" "$css_image" "$primary_image_size" >>"$runtime_detail_style"
elif [[ -n $secondary_gear_image ]]; then
  css_secondary_image=${secondary_gear_image//\\/\\\\}
  css_secondary_image=${css_secondary_image//\"/\\\"}
  secondary_image_size=$(hero_image_size "$secondary_gear_image" single)
  printf '\nwindow {\n  background-image: url("%s"), url("%s");\n  background-repeat: no-repeat, no-repeat;\n  background-position: 26px 20px, center 88px;\n  background-size: 748px 58px, %s;\n}\n\n#outer-box {\n  padding-top: 316px;\n}\n' \
    "$css_title" "$css_secondary_image" "$secondary_image_size" >>"$runtime_detail_style"
else
  printf '\nwindow {\n  background-image: url("%s");\n  background-repeat: no-repeat;\n  background-position: 26px 20px;\n  background-size: 748px 58px;\n}\n\n#outer-box {\n  padding-top: 92px;\n}\n' \
    "$css_title" >>"$runtime_detail_style"
fi
active_detail_style=$runtime_detail_style
detail_lines+=("↗  Open full Sharply page")
log_timing 'detail Wofi launch'
detail_choice=$(printf '%s\n' "${detail_lines[@]}" | wofi --dmenu \
  --prompt "Filter specifications" --style "$active_detail_style" \
  --location center --width "$search_width" --height '65%' --insensitive --matching fuzzy \
  --allow-markup --parse-search --no-custom-entry) || exit 0

if [[ $detail_choice == '↗  Open full Sharply page' ]]; then
  xdg-open "$site/gear/$slug" >/dev/null 2>&1 &
elif [[ -n ${detail_copy[$detail_choice]:-} ]]; then
  copied_spec=${detail_copy[$detail_choice]}
  printf '%s' "$copied_spec" | wl-copy
  if command -v notify-send >/dev/null; then
    notify-send --app-name='Sharply Search' 'Spec copied' "$copied_spec"
  fi
fi
